{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "4gl Form",
  "scopeName": "source.per",
  "fileTypes": [
    "per"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#kw-0"
    },
    {
      "include": "#kw-1"
    },
    {
      "include": "#kw-2"
    },
    {
      "include": "#kw-3"
    },
    {
      "include": "#kw-4"
    },
    {
      "include": "#kw-5"
    },
    {
      "include": "#kw-6"
    },
    {
      "include": "#kw-7"
    },
    {
      "include": "#kw-8"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#field-access"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.per",
          "match": "--.*$",
          "captures": {
            "0": {
              "name": "punctuation.definition.comment.per"
            }
          }
        },
        {
          "name": "comment.line.number-sign.per",
          "match": "#.*$",
          "captures": {
            "0": {
              "name": "punctuation.definition.comment.per"
            }
          }
        },
        {
          "name": "comment.line.decoration.per",
          "match": "^\\s*▼.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.per",
          "begin": "%?\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.per",
              "match": "\\\\."
            },
            {
              "name": "string.quoted.double.embedded.per",
              "match": "\"\""
            }
          ]
        },
        {
          "name": "string.quoted.single.per",
          "begin": "%?'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.per",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.per",
          "match": "(?<![A-Za-z0-9_.])[+-]?[0-9]+\\.[0-9]+"
        },
        {
          "name": "constant.numeric.integer.per",
          "match": "(?<![A-Za-z0-9_.])[+-]?[0-9]+"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "match": "^\\s*([A-Za-z_][A-Za-z0-9_.]*)(\\s*)(=)",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.per"
            },
            "3": {
              "name": "keyword.operator.assignment.per"
            }
          }
        }
      ]
    },
    "field-access": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(\\s*\\.\\s*)([A-Za-z_][A-Za-z0-9_]*|\\*)",
          "captures": {
            "1": {
              "name": "variable.other.object.per"
            },
            "2": {
              "name": "punctuation.accessor.per"
            },
            "3": {
              "name": "variable.other.property.per"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.per",
          "match": "<=|>=|<>|!=|=|<|>"
        },
        {
          "name": "punctuation.separator.per",
          "match": ","
        },
        {
          "name": "parens.per",
          "match": "[()\\[\\]]"
        }
      ]
    },
    "kw-0": {
      "name": "keyword.other.section.per",
      "match": "(?i)\\b(?:ACTION|ATTRIBUTES|DATABASE|DEFAULTS|END|INSTRUCTIONS|KEYS|LAYOUT|SCHEMA|SCREEN|TABLES|TOOLBAR|TOPMENU)\\b"
    },
    "kw-1": {
      "name": "keyword.other.container.per",
      "match": "(?i)\\b(?:FOLDER|GRID|GROUP|HBOX|PAGE|SCROLLGRID|TABLE|TREE|VBOX)\\b"
    },
    "kw-2": {
      "name": "storage.type.item.per",
      "match": "(?i)\\b(?:AGGREGATE|BUTTON|BUTTONEDIT|CANVAS|CHECKBOX|COMBOBOX|DATEEDIT|EDIT|FIELD|FORMONLY|IMAGE|LABEL|PHANTOM|PROGRESSBAR|RADIOGROUP|SLIDER|SPINEDIT|TEXTEDIT|TIMEEDIT|WEBCOMPONENT)\\b"
    },
    "kw-3": {
      "name": "keyword.other.menu.per",
      "match": "(?i)\\b(?:COMMAND|ITEM|SEPARATOR)\\b"
    },
    "kw-4": {
      "name": "keyword.other.directive.per",
      "match": "(?i)\\b(?:DEFAULT|DELIMITERS|RECORD|SAMPLE)\\b"
    },
    "kw-5": {
      "name": "keyword.operator.word.per",
      "match": "(?i)\\b(?:AND|BY|LIKE|NOT|OR|WHERE)\\b"
    },
    "kw-6": {
      "name": "constant.language.per",
      "match": "(?i)\\b(?:FALSE|NULL|TRUE)\\b"
    },
    "kw-7": {
      "name": "keyword.other.misc.per",
      "match": "(?i)\\b(?:CHARACTERS|COLUMNS|INPUT|LINES|PIXELS|POINTS|SIZE|TITLE|TO|TYPE|WITHOUT)\\b"
    },
    "kw-8": {
      "name": "keyword.other.datetime.per",
      "match": "(?i)\\b(?:DAY|FRACTION|HOUR|MINUTE|MONTH|SECOND|YEAR)\\b"
    }
  }
}
