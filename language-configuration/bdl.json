{
  "comments": {
    "lineComment": "--",
    "blockComment": ["{", "}"]
  },
  "brackets": [
    ["{", "}"],
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["(", ")"],
    ["[", "]"],
    ["'", "'"],
    ["\"", "\""]
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_$]*",
  "indentationRules": {
    "increaseIndentPattern": {
      "pattern": "^\\s*(?:(?:PUBLIC|PRIVATE)\\s+)?(?:FUNCTION|MAIN|REPORT)\\b.*$|^\\s*(?:IF|WHILE|FOR|FOREACH|CASE|MENU|INPUT(?:\\s+ARRAY)?|CONSTRUCT|DIALOG|DISPLAY\\s+ARRAY|TRY|WHENEVER)\\b(?!.*\\bEND\\b)",
      "flags": "i"
    },
    "decreaseIndentPattern": {
      "pattern": "^\\s*(?:END\\s+(?:FUNCTION|MAIN|REPORT|IF|WHILE|FOR|FOREACH|CASE|MENU|INPUT|CONSTRUCT|DIALOG|DISPLAY|TRY)\\b|ELSE\\b|WHEN\\b|OTHERWISE\\b|CATCH\\b)",
      "flags": "i"
    }
  }
}
