      },
      {
        "command": "bdl.migrateLinkDir",
        "title": "迁移项目资料目录",
        "category": "Genero BDL"
      },
      {
        "command": "bdl.link.importCsv",
        "title": "链接资料：从 CSV 导入",
        "category": "Genero BDL"
      },
      {
        "command": "bdl.link.syncModules",
        "title": "链接资料：按模组更新",
        "category": "Genero BDL"
      },
      {
        "command": "bdl.link.syncAll",
        "title": "链接资料：全量更新",
        "category": "Genero BDL"
      },
      {
        "command": "bdl.link.status",
