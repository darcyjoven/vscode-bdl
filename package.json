      {
        "command": "bdl.initProject",
        "title": "初始化项目（从生产服务器拉取代码）",
        "category": "Genero BDL"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "bdlLinks",
          "name": "链接资料",
          "when": "workspaceFolderCount > 0 && bdl.link.enabled",
          "icon": "$(link)",
          "contextualTitle": "Genero BDL 链接资料"
        },
        {
          "id": "bdlSchema",
          "name": "数据库字段",
          "when": "workspaceFolderCount > 0 && bdl.schema.enabled",
          "icon": "$(database)",
          "contextualTitle": "Genero BDL 数据库字段"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "bdl.links.refresh",
          "when": "view == bdlLinks && bdl.link.enabled",
          "group": "navigation@1"
        },
        {
          "command": "bdl.link.updateFromDb",
          "when": "view == bdlLinks && bdl.link.modeDb && bdl.db.configured && bdl.link.hasData",
          "group": "navigation@3"
        },
        {
          "command": "bdl.schema.filter",
          "when": "view == bdlSchema && bdl.schema.enabled",
          "group": "navigation@1"
        },
        {
          "command": "bdl.schema.refresh",
          "when": "view == bdlSchema && bdl.schema.enabled",
          "group": "navigation@2"
        },
        {
          "command": "bdl.schema.import",
          "when": "view == bdlSchema && bdl.schema.enabled",
          "group": "navigation@3"
        },
        {
          "command": "bdl.schema.syncSelected",
          "when": "view == bdlSchema && bdl.schema.modeDb && bdl.db.configured && bdl.schema.hasData",
          "group": "navigation@4"
        },
        {
          "command": "bdl.schema.selectAll",
          "when": "view == bdlSchema && bdl.schema.modeDb && bdl.db.configured && bdl.schema.hasData",
          "group": "navigation@5"
        },
        {
          "command": "bdl.schema.clearSelection",
          "when": "view == bdlSchema && bdl.schema.modeDb && bdl.db.configured && bdl.schema.hasData",
          "group": "navigation@6"
        }
      ],
      "view/item/context": [
        {
          "command": "bdl.links.references",
          "when": "view == bdlLinks && viewItem == bdlLinkRefsButton",
          "group": "inline"
        },
        {
          "command": "bdl.schema.syncTable",
          "when": "view == bdlSchema && viewItem == bdlSchemaTable && bdl.schema.modeDb && bdl.db.configured && bdl.schema.hasData",
          "group": "1_sync"
        },
        {
          "command": "bdl.schema.openTable",
          "when": "view == bdlSchema && viewItem == bdlSchemaTable",
          "group": "2_open"
        },
        {
          "command": "bdl.schema.copyColumn",
          "when": "view == bdlSchema && viewItem =~ /^bdlSchemaColumn/",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "bdl.deployCurrentFile",
          "when": "bdl.upload.enabled"
        },
        {
          "command": "bdl.deployDryRun",
          "when": "bdl.upload.enabled"
        },
        {
          "command": "bdl.links.refresh",
          "when": "bdl.link.enabled"
        },
        {
          "command": "bdl.links.references",
          "when": "bdl.link.enabled && editorLangId == 4gl"
        },
        {
          "command": "bdl.links.moreRefs",
          "when": "false"
        },
        {
          "command": "bdl.migrateLinkDir",
          "when": "false"
        },
        {
          "command": "bdl.link.importCsv",
          "when": "bdl.link.enabled"
        },
        {
          "command": "bdl.link.syncModules",
          "when": "bdl.link.modeDb"
        },
        {
          "command": "bdl.link.syncAll",
          "when": "bdl.link.modeDb"
        },
        {
          "command": "bdl.link.status",
          "when": "bdl.link.enabled"
        },
        {
          "command": "bdl.link.updateFromDb",
          "when": "bdl.link.modeDb && bdl.db.configured && bdl.link.hasData"
        },
        {
          "command": "bdl.build.4gl.preview",
          "when": "editorLangId == 4gl && bdl.build.enabled"
        },
        {
          "command": "bdl.build.4gl.compile",
          "when": "editorLangId == 4gl && bdl.build.enabled"
        },
        {
          "command": "bdl.build.4gl.link",
          "when": "editorLangId == 4gl && bdl.build.enabled",
          "enablement": "bdl.build.hasMain"
        },
        {
          "command": "bdl.build.per.preview",
          "when": "editorLangId == per && bdl.build.enabled"
        },
        {
          "command": "bdl.build.per.compile",
          "when": "editorLangId == per && bdl.build.enabled"
        },
        {
          "command": "bdl.build.per.form",
          "when": "editorLangId == per && bdl.build.enabled"
        },
        {
          "command": "bdl.schema.import",
          "when": "bdl.schema.enabled"
        },
        {
          "command": "bdl.schema.refresh",
          "when": "bdl.schema.enabled"
        },
        {
          "command": "bdl.schema.filter",
          "when": "bdl.schema.enabled"
        },
        {
          "command": "bdl.schema.clearFilter",
          "when": "bdl.schema.enabled"
        },
        {
          "command": "bdl.schema.syncAll",
          "when": "bdl.schema.modeDb && bdl.db.configured"
        },
        {
          "command": "bdl.schema.syncSelected",
          "when": "bdl.schema.modeDb && bdl.db.configured && bdl.schema.hasData"
        },
        {
          "command": "bdl.schema.selectAll",
          "when": "bdl.schema.modeDb && bdl.db.configured && bdl.schema.hasData"
        },
        {
          "command": "bdl.schema.clearSelection",
          "when": "bdl.schema.modeDb && bdl.db.configured && bdl.schema.hasData"
        },
        {
          "command": "bdl.forceParseCurrentFile",
          "when": "bdl.parseSkipped"
        },
        {
          "command": "bdl.schema.syncTable",
          "when": "false"
        },
        {
          "command": "bdl.schema.copyColumn",
          "when": "false"
        },
        {
          "command": "bdl.schema.openTable",
          "when": "false"
        },
        {
          "command": "bdl.initProject",
          "when": "workspaceFolderCount > 0"
        }
      ],
      "editor/title": [
        {
          "command": "bdl.deployCurrentFile",
          "when": "(resourceLangId == bdl || resourceLangId == per) && bdl.upload.enabled",
          "group": "navigation@3"
        },
        {
          "command": "bdl.forceParseCurrentFile",
          "when": "bdl.parseSkipped && (resourceLangId == bdl || resourceLangId == per)",
          "group": "navigation"
        },
        {
          "command": "bdl.build.4gl.preview",
          "when": "resourceLangId == bdl && resourceExtname == .4gl && bdl.build.enabled",
          "group": "navigation@4"
        },
        {
          "command": "bdl.build.4gl.compile",
          "when": "resourceLangId == bdl && resourceExtname == .4gl && bdl.build.enabled",
          "group": "navigation@5"
        },
        {
          "command": "bdl.build.4gl.link",
          "when": "resourceLangId == bdl && resourceExtname == .4gl && bdl.build.enabled",
          "group": "navigation@6",
          "enablement": "bdl.build.hasMain"
        },
        {
          "command": "bdl.build.per.preview",
          "when": "resourceLangId == per && bdl.build.enabled",
          "group": "navigation@4"
        },
        {
          "command": "bdl.build.per.compile",
          "when": "resourceLangId == per && bdl.build.enabled",
          "group": "navigation@5"
        },
        {
          "command": "bdl.build.per.form",
          "when": "resourceLangId == per && bdl.build.enabled",
          "group": "navigation@6"
        }
      ],
      "editor/context": [
        {
          "command": "bdl.deployCurrentFile",
          "when": "(resourceLangId == bdl || resourceLangId == per) && bdl.upload.enabled",
          "group": "navigation@1"
        },
        {
          "command": "bdl.deployDryRun",
          "when": "(resourceLangId == bdl || resourceLangId == per) && bdl.upload.enabled",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test:e2e": "npm run build && node test/runTest.js",
    "grammars": "node ../bdl-lsp/scripts/generate-tm-grammars.mjs",
    "grammars:check": "node ../bdl-lsp/scripts/generate-tm-grammars.mjs --check",
    "lint:sh": "node ../bdl-lsp/scripts/check-sh-utf8-vars.mjs .",
    "package": "npm run package:platform",
    "vscode:prepublish": "npm run typecheck && npm run build",
    "package:platform": "npm run typecheck && npm run build && node scripts/package-vsix.mjs",
    "package:dev": "npm run typecheck && npm run build && node scripts/package-vsix.mjs --dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "1.91.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vscode-languageclient": "^10.1.2"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  }
}
