    "views": {
      "explorer": [
        {
          "id": "bdlLinks",
          "name": "链接资料",
          "when": "workspaceFolderCount > 0 && config.bdl.link.enable",
          "icon": "$(link)",
          "contextualTitle": "Genero BDL 链接资料"
        },
        {
          "id": "bdlSchema",
          "name": "数据库字段",
          "when": "workspaceFolderCount > 0 && config.bdl.schema.enable",
          "icon": "$(database)",
          "contextualTitle": "Genero BDL 数据库字段"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "bdl.links.refresh",
          "when": "view == bdlLinks",
          "group": "navigation@1"
        },
        {
          "command": "bdl.links.resync",
          "when": "view == bdlLinks && config.bdl.link.enable",
          "group": "navigation@2"
        },
        {
          "command": "bdl.schema.filter",
          "when": "view == bdlSchema && config.bdl.schema.enable",
          "group": "navigation@1"
        },
        {
          "command": "bdl.schema.refresh",
          "when": "view == bdlSchema && config.bdl.schema.enable",
          "group": "navigation@2"
        },
        {
          "command": "bdl.schema.import",
          "when": "view == bdlSchema && config.bdl.schema.enable",
          "group": "navigation@3"
        },
        {
          "command": "bdl.schema.syncSelected",
          "when": "view == bdlSchema && config.bdl.schema.enable",
          "group": "navigation@4"
        },
        {
          "command": "bdl.schema.selectAll",
          "when": "view == bdlSchema && config.bdl.schema.enable",
          "group": "navigation@5"
        },
        {
          "command": "bdl.schema.clearSelection",
          "when": "view == bdlSchema && config.bdl.schema.enable",
          "group": "navigation@6"
        },
        {
          "command": "bdl.schema.syncFiltered",
          "when": "view == bdlSchema && config.bdl.schema.enable",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "bdl.links.references",
          "when": "view == bdlLinks && viewItem == bdlLinkRefsButton",
          "group": "inline"
        },
        {
          "command": "bdl.links.resync",
          "when": "view == bdlLinks && viewItem == bdlLinkRefsButton && config.bdl.link.enable",
          "group": "inline"
        },
        {
          "command": "bdl.schema.syncTable",
          "when": "view == bdlSchema && viewItem == bdlSchemaTable",
          "group": "1_sync"
        },
        {
          "command": "bdl.schema.openTable",
          "when": "view == bdlSchema && viewItem == bdlSchemaTable",
          "group": "2_open"
        },
        {
          "command": "bdl.schema.copyColumn",
          "when": "view == bdlSchema && viewItem =~ /^bdlSchemaColumn/",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "bdl.deploy",
          "when": "config.bdl.deploy.enable"
        },
        {
          "command": "bdl.deployCurrentFile",
          "when": "config.bdl.deploy.enable"
        },
        {
          "command": "bdl.deployDryRun",
          "when": "config.bdl.deploy.enable"
        },
        {
          "command": "bdl.deployListTargets",
          "when": "config.bdl.deploy.enable"
        },
        {
          "command": "bdl.links.refresh",
          "when": "config.bdl.link.enable"
        },
        {
          "command": "bdl.links.references",
          "when": "config.bdl.link.enable"
        },
        {
          "command": "bdl.links.moreRefs",
          "when": "false"
        },
        {
          "command": "bdl.migrateLinkDir",
          "when": "false"
        },
        {
          "command": "bdl.link.importCsv",
          "when": "config.bdl.link.enable"
        },
        {
          "command": "bdl.link.syncCurrent",
          "when": "config.bdl.link.enable"
        },
        {
          "command": "bdl.link.syncModules",
          "when": "config.bdl.link.enable"
        },
        {
          "command": "bdl.link.syncAll",
          "when": "config.bdl.link.enable"
        },
        {
          "command": "bdl.link.status",
          "when": "config.bdl.link.enable"
        },
        {
          "command": "bdl.links.resync",
          "when": "config.bdl.link.enable"
        },
        {
          "command": "bdl.schema.import",
          "when": "config.bdl.schema.enable"
        },
        {
          "command": "bdl.schema.refresh",
          "when": "config.bdl.schema.enable"
        },
        {
          "command": "bdl.schema.filter",
          "when": "config.bdl.schema.enable"
        },
        {
          "command": "bdl.schema.clearFilter",
          "when": "config.bdl.schema.enable"
        },
        {
          "command": "bdl.schema.syncTable",
          "when": "config.bdl.schema.enable"
        },
        {
          "command": "bdl.schema.copyColumn",
          "when": "config.bdl.schema.enable"
        },
        {
          "command": "bdl.schema.openTable",
          "when": "config.bdl.schema.enable"
        },
        {
          "command": "bdl.schema.syncAll",
          "when": "config.bdl.schema.enable"
        },
        {
          "command": "bdl.schema.syncSelected",
          "when": "config.bdl.schema.enable"
        },
        {
          "command": "bdl.schema.selectAll",
          "when": "config.bdl.schema.enable"
        },
        {
          "command": "bdl.schema.clearSelection",
          "when": "config.bdl.schema.enable"
        },
        {
          "command": "bdl.schema.syncFiltered",
          "when": "config.bdl.schema.enable"
        }
      ],
      "editor/title": [
        {
          "command": "bdl.forceParseCurrentFile",
          "when": "bdl.parseSkipped && (resourceLangId == bdl || resourceLangId == per)",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test:e2e": "npm run build && node test/runTest.js",
    "grammars": "node ../bdl-lsp/scripts/generate-tm-grammars.mjs",
    "grammars:check": "node ../bdl-lsp/scripts/generate-tm-grammars.mjs --check",
    "package": "npm run package:platform",
    "vscode:prepublish": "npm run typecheck && npm run build",
    "package:platform": "npm run typecheck && npm run build && node scripts/package-vsix.mjs",
    "package:dev": "npm run typecheck && npm run build && node scripts/package-vsix.mjs --dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "1.91.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vscode-languageclient": "^10.1.2"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  }
}
