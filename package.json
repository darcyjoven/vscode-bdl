        "icon": "$(cloud-download)"
      },
      {
        "command": "bdl.build.4gl.preview",
        "title": "4GL：预演编译",
        "category": "Genero BDL",
        "icon": "$(beaker)"
      },
      {
        "command": "bdl.build.4gl.compile",
        "title": "4GL：编译",
        "category": "Genero BDL",
        "icon": "$(play)"
      },
      {
        "command": "bdl.build.4gl.link",
        "title": "4GL：链接",
        "category": "Genero BDL",
