{
  "name": "4gl-full",
  "displayName": "Genero BDL (4GL)",
  "description": "Genero BDL（.4gl）与 Form（.per）的完整语言支持：语法高亮、定义/引用跳转、符号大纲、悬停、语法诊断。",
  "version": "0.1.0",
  "publisher": "darcyjoven",
  "license": "MIT",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "genero",
    "bdl",
    "4gl",
    "per",
    "form",
    "fgl"
  ],
  "main": "./dist/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/darcyjoven/vscode-bdl.git"
  },
  "bugs": {
    "url": "https://github.com/darcyjoven/vscode-bdl/issues"
  },
  "activationEvents": [
    "onLanguage:bdl",
    "onLanguage:per"
  ],
  "contributes": {
    "languages": [
      {
        "id": "bdl",
        "aliases": [
          "Genero BDL",
          "bdl",
          "4gl"
        ],
        "extensions": [
          ".4gl",
          ".global"
        ],
        "configuration": "./language-configuration/bdl.json"
      },
      {
        "id": "per",
        "aliases": [
          "Genero Form",
          "per"
        ],
        "extensions": [
          ".per"
        ],
        "configuration": "./language-configuration/per.json"
      }
    ],
    "grammars": [
      {
        "language": "bdl",
        "scopeName": "source.4gl",
        "path": "./syntaxes/bdl.tmLanguage.json"
      },
      {
        "language": "per",
        "scopeName": "source.per",
        "path": "./syntaxes/per.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Genero BDL",
      "properties": {
        "bdl.deploy.target": {
          "type": "string",
          "default": "",
          "scope": "window",
          "markdownDescription": "部署目标名（对应 `.bdl-lsp/deploy.json` 的 `targets` 键）。留空则用配置里的 `defaultTarget`。"
        },
        "bdl.fieldDiagnostics": {
          "type": "string",
          "enum": [
            "off",
            "error",
            "warning",
            "information",
            "hint"
          ],
          "default": "warning",
          "scope": "window",
          "description": "4GL 字段存在性校验（字段不在引用的表单 .per 中）与 .per 内部一致性检查的诊断级别。"
        },
        "bdl.format.indentSize": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 16,
          "scope": "window",
          "markdownDescription": "每级缩进的宽度（`indentStyle` 为 `space` 时的空格数，为 `tab` 时仅影响显示宽度）。`0` 表示跟随编辑器 `editor.tabSize`。"
        },
        "bdl.format.indentStyle": {
          "type": "string",
          "enum": [
            "auto",
            "tab",
            "space"
          ],
          "default": "auto",
          "scope": "window",
          "markdownDescription": "格式化时的缩进字符：`auto` 跟随编辑器 `editor.insertSpaces` 设置、`tab` 强制制表符、`space` 强制空格。"
        },
        "bdl.format.keywords": {
          "type": "string",
          "enum": [
            "unchanged",
            "upper",
            "lower"
          ],
          "default": "unchanged",
          "scope": "window",
          "markdownDescription": "格式化时关键字的大小写处理：`unchanged` 保持不变、`upper` 转大写、`lower` 转小写。\n\n仅改写关键字本身，不动空白、标点与换行；含语法错误的文件整体跳过格式化。"
        },
        "bdl.generoVersion": {
          "type": "string",
          "enum": [
            "2.50",
            "3.00",
            "4.00"
          ],
          "default": "2.50",
          "scope": "window",
          "markdownDescription": "目标 Genero 版本。当前语法基线为 **2.50**；更高版本的差异尚未实现。"
        },
        "bdl.globals.fileNotFoundDiagnostics": {
          "type": "string",
          "enum": [
            "off",
            "error",
            "warning",
            "information",
            "hint"
          ],
          "default": "warning",
          "scope": "window",
          "description": "GLOBALS 引用的文件（.global 等）找不到时的诊断级别。"
        },
        "bdl.globals.searchPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "window",
          "markdownDescription": "GLOBALS 文件路径的附加解析根（相对工作区根，按序尝试）。适用于引用写法按引用文件目录解析不到、但文件在工作区其他位置的场景（如各模块目录层级不一致的 `../../config/top.global`）。"
        },
        "bdl.globals.unresolvedSourceDiagnostics": {
          "type": "string",
          "enum": [
            "off",
            "error",
            "warning",
            "information",
            "hint"
          ],
          "default": "warning",
          "scope": "window",
          "description": "变量使用处查不到任何定义（局部/模块级/GLOBALS 引入均无）时的诊断级别。设为 off 关闭。"
        },
        "bdl.limits.maxFileBytes": {
          "type": "number",
          "default": 2097152,
          "scope": "window",
          "description": "超过该字节数的文件不做语法诊断（仍可高亮与跳转）。"
        },
        "bdl.limits.maxFileLines": {
          "type": "number",
          "default": 20000,
          "scope": "window",
          "description": "超过该行数的文件不做语法诊断。"
        },
        "bdl.limits.maxIssues": {
          "type": "number",
          "default": 200,
          "scope": "window",
          "description": "单个文件最多报告的诊断条数，防止极端文件刷屏。"
        },
        "bdl.limits.parseTimeoutMs": {
          "type": "number",
          "default": 2000,
          "scope": "window",
          "description": "单次解析的超时时间（毫秒）。超时后保留上一次诊断。"
        },
        "bdl.missingDiagnostics": {
          "type": "string",
          "enum": [
            "off",
            "error",
            "warning",
            "information",
            "hint"
          ],
          "default": "warning",
          "scope": "window",
          "description": "缺失内容（例如缺少 END IF、缺少逗号）的诊断级别。"
        },
        "bdl.perRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "window",
          "markdownDescription": "`.per` 表单文件的附加查找根（相对工作区根，按序尝试）。表单路径先按 `4gl 同级 per 目录` 解析，失败后尝试这些根，最后按 basename 在工作区内唯一匹配。"
        },
        "bdl.recordMemberDiagnostics": {
          "type": "string",
          "enum": [
            "off",
            "error",
            "warning",
            "information",
            "hint"
          ],
          "default": "off",
          "scope": "window",
          "markdownDescription": "`BY NAME rec.member` 的记录成员存在性校验级别。\n\n**默认 `off`**：记录成员静态上只能靠 `TYPE..END RECORD` 的字段列表判断，而 `DEFINE r LIKE table.*`（按数据库列展开）在真实项目里很常见，静态看不到列名。\n\n语料实测（7699 个 .4gl，开启后）：可校验 281160 处引用，报出 157 处（**0.1%**），抽查确认为真阳性（如 `g_tc_ibb_m.tc_ibb003` 多打一个 0，记录里只有 `tc_ibb03`）。"
        },
        "bdl.server.logLevel": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug"
          ],
          "default": "info",
          "scope": "machine-overridable",
          "markdownDescription": "语言服务器日志级别。日志同时写入扩展日志目录。修改后需重启语言服务器。"
        },
        "bdl.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "`bdl-lsp` 可执行文件路径（文件或所在目录）。留空时依次查找：环境变量 `BDL_LSP_PATH`、工作区 `.bdl-lsp/bin/bdl-lsp`、系统 `PATH`。修改后需重启语言服务器。"
        },
        "bdl.syntaxDiagnostics": {
          "type": "string",
          "enum": [
            "off",
            "error",
            "warning",
            "information",
            "hint"
          ],
          "default": "error",
          "scope": "window",
          "description": "语法错误（无法解析的片段）的诊断级别。"
        },
        "bdl.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "记录客户端与语言服务器之间的 LSP 消息（输出到「Genero BDL 追踪」通道）。"
        }
      }
    },
    "configurationDefaults": {
      "[bdl]": {
        "editor.defaultFormatter": "darcyjoven.4gl-full"
      }
    },
    "commands": [
      {
        "command": "bdl.restartServer",
        "title": "重启语言服务器",
        "category": "Genero BDL"
      },
      {
        "command": "bdl.showServerInfo",
        "title": "显示语言服务器信息",
        "category": "Genero BDL"
      },
      {
        "command": "bdl.showOutput",
        "title": "显示输出",
        "category": "Genero BDL"
      },
      {
        "command": "bdl.deploy",
        "title": "部署到远程服务器并编译",
        "category": "Genero BDL"
      },
      {
        "command": "bdl.deployCurrentFile",
        "title": "部署当前文件并编译",
        "category": "Genero BDL"
      },
      {
        "command": "bdl.deployDryRun",
        "title": "部署预演（不上传）",
        "category": "Genero BDL"
      },
      {
        "command": "bdl.deployListTargets",
        "title": "列出部署目标",
        "category": "Genero BDL"
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test:e2e": "npm run build && node test/runTest.js",
    "grammars": "node ../bdl-lsp/scripts/generate-tm-grammars.mjs",
    "grammars:check": "node ../bdl-lsp/scripts/generate-tm-grammars.mjs --check",
    "package": "npm run typecheck && npm run build && vsce package --no-dependencies --allow-missing-repository --skip-license",
    "vscode:prepublish": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "1.91.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vscode-languageclient": "^10.1.2"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  }
}
