      },
      {
        "command": "bdl.build.per.preview",
        "title": "Form：预演编译",
        "category": "Genero BDL",
        "icon": "$(beaker)"
      },
      {
        "command": "bdl.build.per.compile",
        "title": "Form：编译",
        "category": "Genero BDL",
        "icon": "$(play)"
      },
      {
        "command": "bdl.build.per.form",
        "title": "Form：预览画面",
        "category": "Genero BDL",
        "icon": "$(eye)"
      },
      {
        "command": "bdl.schema.import",
        "title": "数据库字段：从 CSV 导入",
        "category": "Genero BDL",
        "icon": "$(file-add)"
      },
      {
        "command": "bdl.schema.refresh",
        "title": "数据库字段：刷新",
        "category": "Genero BDL",
        "icon": "$(refresh)"
      },
      {
        "command": "bdl.schema.filter",
        "title": "数据库字段：正则过滤表名",
        "category": "Genero BDL",
        "icon": "$(filter)"
      },
      {
        "command": "bdl.schema.clearFilter",
        "title": "数据库字段：清除过滤",
